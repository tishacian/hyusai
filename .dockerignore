# Python cache and compiled files
**__pycache__/
**.py[cod]
**$py.class
**.cache/
**.mypy_cache/
**.pytest_cache/
**.ruff_cache/

# Terraform providers and local state are build-time infrastructure artifacts.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan

# Jupyter Notebook
**.ipynb_checkpoints

# Spyder project settings
**.spyderproject
**.spyproject

# Generated by MacOS
**.DS_Store

# Virtual environments and env files. The **/ forms matter: a pattern without
# them only matches at the root, and a nested backend/.venv or docker/env/*.env
# (the VM's runtime secrets) would otherwise be baked into an image layer.
venv/
env/
.venv/
.env/
.env
tests.env
.venv
**/venv/
**/.venv/
**/.env
docker/env/*.env

# Agent and editor worktrees (full repository copies)
.claude/
.cursor/

# Version control
.git/
.gitignore

# OS and IDE files
**.idea/
**.vscode/

# Logs and temp files
**.log
**.swp
*~

# Generated data and downloaded models
vector_store/
backend/data/
backend/downloads/
backend/faiss_db/
backend/chroma_db/
backend/.sharepoint_sessions/
node_modules/
frontend-ng/node_modules/
frontend-ng/.angular/
frontend-ng/dist/
docs/status-screenshots/
knowledge-bases/*
**.db

# Unnecessary code
.pre-commit-config.yaml

# Secrets
**/secrets/
# Code packages named "secrets" (registry service, UI) are source, not runtime secrets.
!backend/app/services/secrets/
!frontend-ng/src/app/shared/secrets/
