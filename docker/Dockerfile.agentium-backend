# A release pins the digest it qualified (python:3.12-slim@sha256:…); the bare
# tag moves under us, and the Python constraints do not freeze the OS layer.
ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

# Everything down to the "image-specific layers" marker is instruction-for-
# instruction identical in Dockerfile.agentium-worker. BuildKit keys a layer on
# its instruction and its parent, not on the file it came from, so the Python
# stack — the multi-gigabyte part — is built once and stored once for both
# images. test_demo_dependency_constraints pins the two prefixes together.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ARG PIP_INDEX_URL
RUN : "${PIP_INDEX_URL:?PIP_INDEX_URL is required}"

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        fonts-dejavu \
        libreoffice-writer \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

# One constraints file for the API and the worker: a model is fitted in the
# worker and unpickled here, so both interpreters run the same numpy, scipy,
# scikit-learn, skops and mlflow.
COPY backend/requirements.txt backend/constraints-demo-app.txt /tmp/requirements/
RUN pip install --no-cache-dir \
    --constraint=/tmp/requirements/constraints-demo-app.txt \
    --index-url=${PIP_INDEX_URL} \
    -r /tmp/requirements/requirements.txt

# Cross-encoder rerank stage (FlashReranker) needs torch + transformers only.
# Install torch from the PyTorch CPU index (serves +cpu wheels exclusively),
# avoiding the multi-GB CUDA build pulled by the default PyPI wheel.
#
# torchvision comes from the same index, and for the same reason it has to: it
# must be the +cpu build matching this torch, or its compiled ops are absent
# and importing it raises "operator torchvision::nms does not exist". It is
# here because transformers treats it as a peer of torch — several of its image
# processors import it at module scope — and its lazy __getattr__ imports those
# modules on demand. Any module scan in this process therefore walks into them:
# skops builds its trusted-type tables at import by asking every resident
# module whether it owns a name, which is the same walk pickle.whichmodule
# does, and without torchvision that walk raised ModuleNotFoundError and no
# model could be deserialised for /predict.
RUN pip install --no-cache-dir torch torchvision \
        --constraint=/tmp/requirements/constraints-demo-app.txt \
        --index-url=https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        --constraint=/tmp/requirements/constraints-demo-app.txt \
        --index-url=${PIP_INDEX_URL} \
        "transformers>=4.41.0" \
    && pip check

# ---- image-specific layers ----

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME=agentium
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid "$USER_GID" "$USERNAME" \
    && useradd --uid "$USER_UID" --gid "$USER_GID" --create-home "$USERNAME"

WORKDIR /app

COPY --chown=$USERNAME:$USERNAME . .

RUN chmod +x /app/docker/run_backend.sh \
    && mkdir -p /data/object_store /data/secure_deposit /app/vector_store \
    && chown -R "$USERNAME":"$USERNAME" /data /app/vector_store

USER $USERNAME

ENV PYTHONPATH=/app/backend:/app
WORKDIR /app/backend

EXPOSE 8000

ARG AGENTIUM_IMAGE_REVISION=unknown
ENV AGENTIUM_IMAGE_REVISION=${AGENTIUM_IMAGE_REVISION}
LABEL org.opencontainers.image.revision="${AGENTIUM_IMAGE_REVISION}"

CMD ["/app/docker/run_backend.sh"]
