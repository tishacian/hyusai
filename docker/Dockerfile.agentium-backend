FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ARG PIP_INDEX_URL
RUN : "${PIP_INDEX_URL:?PIP_INDEX_URL is required}"

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        fonts-dejavu \
        libreoffice-impress \
        libreoffice-writer \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements/
RUN pip install --no-cache-dir \
    --index-url=${PIP_INDEX_URL} \
    -r /tmp/requirements/requirements.txt

# Cross-encoder rerank stage (FlashReranker) needs torch + transformers only.
# Install torch from the PyTorch CPU index (serves +cpu wheels exclusively),
# avoiding the multi-GB CUDA build pulled by the default PyPI wheel.
RUN pip install --no-cache-dir torch \
        --index-url=https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        --index-url=${PIP_INDEX_URL} \
        "transformers>=4.41.0"

ARG USERNAME=agentium
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid "$USER_GID" "$USERNAME" \
    && useradd --uid "$USER_UID" --gid "$USER_GID" --create-home "$USERNAME"

WORKDIR /app

COPY --chown=$USERNAME:$USERNAME . .

RUN chmod +x /app/docker/run_backend.sh \
    && mkdir -p /data/object_store /data/secure_deposit /app/vector_store \
    && chown -R "$USERNAME":"$USERNAME" /data /app/vector_store

USER $USERNAME

ENV PYTHONPATH=/app/backend:/app
WORKDIR /app/backend

EXPOSE 8000

ARG AGENTIUM_IMAGE_REVISION=unknown
ENV AGENTIUM_IMAGE_REVISION=${AGENTIUM_IMAGE_REVISION}
LABEL org.opencontainers.image.revision="${AGENTIUM_IMAGE_REVISION}"

CMD ["/app/docker/run_backend.sh"]
