FROM node:22-bookworm-slim

WORKDIR /app/livekit-agent

COPY livekit-agent/package.json livekit-agent/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY livekit-agent/src ./src

ENV LIVEKIT_AGENT_HOST=0.0.0.0 \
    LIVEKIT_AGENT_PORT=8090

RUN npm run check && npm test

ARG AGENTIUM_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${AGENTIUM_IMAGE_REVISION}"

EXPOSE 8090

CMD ["npm", "run", "start"]
