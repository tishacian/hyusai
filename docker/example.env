### Copy this file to the app root and rename it to .env
# General
GENERAL_IS_STANDALONE=True
# Backend
BACKEND_DISABLE_OCR_FOR_PDF=False
BACKEND_FORCE_OCR_ON_ALL_PDF=False
# Standalone interface
STANDALONE_INTERFACE_PAGE_ICON=🦙
STANDALONE_INTERFACE_PAGE_TITLE=OmniRAG
STANDALONE_INTERFACE_HEADER_TITLE=OmniRAG
STANDALONE_INTERFACE_AI_CHAT_LOGO=image/datategy_logo.png
STANDALONE_INTERFACE_HUMAN_CHAT_LOGO=image/aitubo.jpg
STANDALONE_INTERFACE_HIDE_RAG_PARAMS_CONFIG=False
STANDALONE_INTERFACE_FORCED_VDB=None
STANDALONE_INTERFACE_DEFAULT_GPU_MODEL=neuralmagic/Meta-Llama-3.1-8B-Instruct-quantized.w4a16
# Database
DATABASE_DIALECT=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnirag_database
DATABASE_USERNAME=username
DATABASE_PASSWORD=password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# PostgreSQL
POSTGRES_DB=omnirag_database
POSTGRES_USER=username
POSTGRES_PASSWORD=password