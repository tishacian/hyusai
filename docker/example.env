# Example environment variables for Docker builds
# This file is not used directly, but serves as a template for setting environment variables
# when building Docker images. You can copy this file to .env and modify the values as needed.
PIP_INDEX_URL=https://pypi.org/simple

# LiveKit realtime profile. Keep disabled unless docker compose is started with
# --profile realtime and the VM firewall/Nginx path is ready.
LIVEKIT_ENABLED=false
LIVEKIT_IMAGE_TAG=v1.12.0
LIVEKIT_URL=wss://agentium.papai.ai/livekit
LIVEKIT_INTERNAL_URL=http://agentium-livekit:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me-with-at-least-32-characters
LIVEKIT_WEBHOOK_API_KEY=replace-me
LIVEKIT_WEBHOOK_API_SECRET=replace-me-with-at-least-32-characters
LIVEKIT_KEYS=replace-me: replace-me-with-at-least-32-characters
LIVEKIT_AGENT_DISPATCH_URL=http://agentium-livekit-agent:8090/dispatch
LIVEKIT_AGENT_CONNECT_ATTEMPTS=6
LIVEKIT_AGENT_CONNECT_RETRY_MS=500
LIVEKIT_AGENT_CONNECT_MAX_RETRY_MS=3000
LIVEKIT_VOICE_GATEWAY_WS_URL=ws://agentium-backend:8000/api/v1/voice/sessions
LIVEKIT_VOICE_BRIDGE_TOKEN_TTL_SECONDS=3600
LIVEKIT_HTTP_HOST_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_RANGE_START=50000
LIVEKIT_RTC_UDP_RANGE_END=50100
LIVEKIT_RTC_BIND_HOST=0.0.0.0
# Optional P3 scale/governance switches. Leave Redis empty for the single-node
# VM demo. Use agentium-livekit-redis:6379 only with --profile realtime-scale.
LIVEKIT_REDIS_ADDRESS=
LIVEKIT_REDIS_USERNAME=
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_DB=
LIVEKIT_TURN_MODE=external_or_none
LIVEKIT_AGENTS_MODE=sidecar_http_bridge
LIVEKIT_EGRESS_ENABLED=false
LIVEKIT_RECORDING_ALLOWED_WORKSPACE_SLUGS=
