### Copy this file to the app root and rename it to .env
# General
GENERAL__IS_STANDALONE=True
# Backend
BACKEND__DISABLE_OCR_FOR_PDF=False
BACKEND__FORCE_OCR_ON_ALL_PDF=False
# Standalone interface
STANDALONE_INTERFACE__PAGE_ICON=🦙
STANDALONE_INTERFACE__PAGE_TITLE=OmniRAG
STANDALONE_INTERFACE__HEADER_TITLE=OmniRAG
STANDALONE_INTERFACE__AI_CHAT_LOGO=image/datategy_logo.png
STANDALONE_INTERFACE__HUMAN_CHAT_LOGO=image/aitubo.jpg
STANDALONE_INTERFACE__HIDE_RAG_PARAMS_CONFIG=False
STANDALONE_INTERFACE__FORCED_VDB=None
STANDALONE_INTERFACE__DEFAULT_GPU_MODEL=neuralmagic/Meta-Llama-3.1-8B-Instruct-quantized.w4a16
# Database
DATABASE__DIALECT=postgresql
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=omnirag_database
DATABASE__USERNAME=username
DATABASE__PASSWORD=password
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
# PostgreSQL
POSTGRES__DB=omnirag_database
POSTGRES__USER=username
POSTGRES__PASSWORD=password
