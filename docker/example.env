### Copy this file to the app root and rename it to .env
# General
IS_STANDALONE=True
# Backend
DISABLE_OCR_FOR_PDF=False
FORCE_OCR_ON_ALL_PDF=False
# Standalone interface
PAGE_ICON=🦙
PAGE_TITLE=OmniRAG
HEADER_TITLE=OmniRAG
AI_CHAT_LOGO=image/datategy_logo.png
HUMAN_CHAT_LOGO=image/aitubo.jpg
HIDE_RAG_PARAMS_CONFIG=False
FORCED_VDB=None
DEFAULT_GPU_MODEL=neuralmagic/Meta-Llama-3.1-8B-Instruct-quantized.w4a16
# Database
DATABASE_DIALECT=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnirag_database
DATABASE_USERNAME=username
DATABASE_PASSWORD=password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# PostgreSQL
POSTGRES_DB=omnirag_database
POSTGRES_USER=username
POSTGRES_PASSWORD=password