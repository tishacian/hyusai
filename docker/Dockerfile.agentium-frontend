FROM node:22-bookworm-slim AS build

WORKDIR /app/frontend-ng

ARG AGENTIUM_IMAGE_REVISION=unknown
ENV AGENTIUM_IMAGE_REVISION=${AGENTIUM_IMAGE_REVISION}

COPY frontend-ng/package.json frontend-ng/package-lock.json ./
RUN npm ci

COPY frontend-ng/ ./
RUN node scripts/write-build-info.mjs
RUN npm run build:prod

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY docker/nginx/agentium-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend-ng/dist/agentium/browser /usr/share/nginx/html

EXPOSE 8080

ARG AGENTIUM_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${AGENTIUM_IMAGE_REVISION}"

CMD ["nginx", "-g", "daemon off;"]
