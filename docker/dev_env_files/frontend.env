# Logging
LOG_LEVEL=info

# FastAPI backend URL
API_HOST=fastapi
API_PORT=8000
API_PROTOCOL=http

# UI appearance
UI_PAGE_TITLE=OmniRAG
UI_PAGE_ICON=🦙
UI_HEADER_TITLE=OmniRAG
UI_HIDE_RAG_PARAMS=false
UI_FORCED_COLLECTION=None

# Authentication
AUTH_SKIP=false
AUTH_COOKIE_NAME=omnirag_auth
AUTH_COOKIE_KEY=write_here_your_cookie_key
AUTH_COOKIE_EXPIRY_DAYS=1
