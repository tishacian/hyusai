# Database (SQLAlchemy — common_config.sqlalchemy_database.SQLAlchemyDBConfig)
SQLALCHEMY_DB_ENGINE_URL__HOST=db
SQLALCHEMY_DB_ENGINE_URL__PORT=5432
SQLALCHEMY_DB_ENGINE_URL__DB_NAME=papai_llm_database
SQLALCHEMY_DB_ENGINE_URL__USERNAME=username
SQLALCHEMY_DB_ENGINE_URL__PASSWORD=password
SQLALCHEMY_DB_ENGINE_URL__DIALECT=postgresql+psycopg
SQLALCHEMY_DB_ENGINE_OPTIONS__POOL_SIZE=5
SQLALCHEMY_DB_ENGINE_OPTIONS__MAX_OVERFLOW=10

# File storage (fsspec — common_config.fsspec_storage.FsspecStorageConfig)
FSSPEC_STORAGE_NAME=s3
FSSPEC_STORAGE_OPTIONS__ENDPOINT_URL=http://minio:9000
FSSPEC_STORAGE_OPTIONS__KEY=minio_username
FSSPEC_STORAGE_OPTIONS__SECRET=minio_password

# Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=changeme

# Message broker
BROKER_HOST=broker
BROKER_PORT=5672
BROKER_USER=guest
BROKER_PASSWORD=guest
BROKER_VHOST=/

# Celery result backend
CELERY_RESULT_HOST=db
CELERY_RESULT_PORT=5432
CELERY_RESULT_DB=papai_llm_database
CELERY_RESULT_USER=username
CELERY_RESULT_PASSWORD=password

# Core (external service that tracks task progress)
CORE_BASE_HTTP_URL=https://www.datategy.net/

# Logging
LOG_LEVEL=info

# Celery worker behavior
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_MAX_MEMORY_PER_CHILD=20000

# Asset paths
RESOURCES_TESSDATA=/data/assets/tessdata
RESOURCES_NLTK=/data/assets/nltk_data
RESOURCES_CUSTOM=/data/assets/custom

# Python-level paths (used by libraries at runtime)
TESSDATA_PREFIX=/data/assets/tessdata
NLTK_DATA=/data/assets/nltk_data
HF_HOME=/data/models/hf_data
