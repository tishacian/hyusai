## FastAPI app configuration
# Uvicorn
PAPAI_LLM_FASTAPI_UVICORN__HOST=fastapi
PAPAI_LLM_FASTAPI_UVICORN__PORT=8000
PAPAI_LLM_FASTAPI_UVICORN__LOG_LEVEL=debug
# Celery broker
PAPAI_LLM_CELERY_CELERY_BROKER__URL__TRANSPORT=amqp
PAPAI_LLM_CELERY_CELERY_BROKER__URL__USERNAME=guest
PAPAI_LLM_CELERY_CELERY_BROKER__URL__PASSWORD=guest
PAPAI_LLM_CELERY_CELERY_BROKER__URL__HOSTNAME=broker
PAPAI_LLM_CELERY_CELERY_BROKER__URL__PORT=5672
PAPAI_LLM_CELERY_CELERY_BROKER__URL__VIRTUAL_HOST=/
# Celery result backend
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__HOST=db
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__DB_NAME=papai_llm_database
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__USERNAME=username
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__PASSWORD=password
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__PORT=5432
PAPAI_LLM_CELERY_CELERY_RESULT_BACKEND__URL__DIALECT=postgresql
# Core
PAPAI_LLM_CELERY_CORE__BASE_HTTP_URL=https://www.datategy.net/
# Database
PAPAI_LLM_CELERY_DB__ENGINE_URL__HOST=db
PAPAI_LLM_CELERY_DB__ENGINE_URL__DB_NAME=papai_llm_database
PAPAI_LLM_CELERY_DB__ENGINE_URL__USERNAME=username
PAPAI_LLM_CELERY_DB__ENGINE_URL__PASSWORD=password
PAPAI_LLM_CELERY_DB__ENGINE_URL__PORT=5432
PAPAI_LLM_CELERY_DB__ENGINE_URL__DIALECT=postgresql
PAPAI_LLM_CELERY_DB__ENGINE_OPTIONS__POOL_SIZE=5
PAPAI_LLM_CELERY_DB__ENGINE_OPTIONS__MAX_OVERFLOW=10
# Minio
PAPAI_LLM_CELERY_STORAGE__NAME=s3
PAPAI_LLM_CELERY_STORAGE__OPTIONS__ENDPOINT_URL=http://minio:9000
PAPAI_LLM_CELERY_STORAGE__OPTIONS__KEY=minio_username
PAPAI_LLM_CELERY_STORAGE__OPTIONS__SECRET=minio_password
