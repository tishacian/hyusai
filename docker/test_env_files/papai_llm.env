# Frontend Interface
PAPAILLM_INTERFACE__SKIP_AUTHENTICATION=False
PAPAILLM_INTERFACE__COOKIE_KEY=write_here_your_cookie_key
# Celery DB
PAPAILLM_CELERY_DB__URL__HOST=db
PAPAILLM_CELERY_DB__URL__DB_NAME=papai_llm_database
PAPAILLM_CELERY_DB__URL__USERNAME=username
PAPAILLM_CELERY_DB__URL__PASSWORD=password
PAPAILLM_CELERY_DB__URL__PORT=5432
PAPAILLM_CELERY_DB__URL__DIALECT=postgresql
# Core
PAPAILLM_CORE__BASE_HTTP_URL=https://www.datategy.net/
# Broker
PAPAILLM_BROKER__URL__TRANSPORT=amqp
PAPAILLM_BROKER__URL__USERNAME=guest
PAPAILLM_BROKER__URL__PASSWORD=guest
PAPAILLM_BROKER__URL__HOSTNAME=broker
PAPAILLM_BROKER__URL__PORT=5672
PAPAILLM_BROKER__URL__VIRTUAL_HOST=/
# Database
PAPAILLM_DATABASE__ENGINE_URL__HOST=db
PAPAILLM_DATABASE__ENGINE_URL__DB_NAME=papai_llm_database
PAPAILLM_DATABASE__ENGINE_URL__USERNAME=username
PAPAILLM_DATABASE__ENGINE_URL__PASSWORD=password
PAPAILLM_DATABASE__ENGINE_URL__PORT=5432
PAPAILLM_DATABASE__ENGINE_URL__DIALECT=postgresql
PAPAILLM_DATABASE__ENGINE_OPTIONS__POOL_SIZE=5
PAPAILLM_DATABASE__ENGINE_OPTIONS__MAX_OVERFLOW=10
# Storage
PAPAILLM_STORAGE__NAME=s3
PAPAILLM_STORAGE__OPTIONS__ENDPOINT_URL=http://minio:9000
PAPAILLM_STORAGE__OPTIONS__KEY=minio_username
PAPAILLM_STORAGE__OPTIONS__SECRET=minio_password
# Ressources
PAPAILLM_RESSOURCES__TESSDATA=/data/assets/tessdata
PAPAILLM_RESSOURCES__NLTK_DATA=/data/assets/nltk_data
PAPAILLM_RESSOURCES__CUSTOM=/data/assets/custom

# Python packages
TESSDATA_PREFIX=/data/assets/tessdata
NLTK_DATA=/data/assets/nltk_data

# Agentium canonical backend
DATABASE_URL=postgresql://username:password@db:5432/papai_llm_database
DEFAULT_VECTOR_DB_TYPE=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
CELERY_BROKER_URL=amqp://guest:guest@broker:5672//
CELERY_TASK_DEFAULT_QUEUE=cpu
DOCUMENT_INGEST_ASYNC_ENABLED=true
WORKER_EAGER_MODE=false
OBJECT_STORE_BACKEND=local
OBJECT_STORE_BASE_PATH=/data/assets/object_store
BM25_REBUILD_INLINE_MAX_CHUNKS=50000
