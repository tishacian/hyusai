KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db:5432/papai_llm_database
KC_DB_USERNAME=username
KC_DB_PASSWORD=password
# Bootstrap admin — consumed ONLY on first Keycloak start against an
# empty DB. On prod `omnirag-demo` the bootstrap user has been
# disabled (see docs/ops/keycloak-admin.md), these vars are dead
# code there. For a fresh dev stack, set both env vars to a
# *non-trivial* value before first-start and rotate them afterwards.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_HEALTH_ENABLED=true
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false
