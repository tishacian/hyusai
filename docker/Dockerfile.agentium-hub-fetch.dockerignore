# Python cache and compiled files
**__pycache__/
**.py[cod]
**$py.class
**.cache/
**.mypy_cache/
**.pytest_cache/
**.ruff_cache/

# Jupyter Notebook
**.ipynb_checkpoints

# Spyder project settings
**.spyderproject
**.spyproject

# Generated by MacOS
**.DS_Store

# Virtual environments and env files. The **/ forms matter: a pattern without
# them only matches at the root, and a nested backend/.venv or docker/env/*.env
# (the VM's runtime secrets) would otherwise be baked into an image layer.
venv/
env/
.venv/
.env/
.env
tests.env
.venv
**/venv/
**/.venv/
**/.env
docker/env/*.env

# Agent and editor worktrees (full repository copies)
.claude/
.cursor/

# Version control
.git/
.gitignore

# OS and IDE files
**.idea/
**.vscode/

# Logs and temp files
**.log
**.swp
*~

# Generated data and downloaded models
vector_store/
backend/data/
backend/downloads/
backend/faiss_db/
backend/chroma_db/
backend/.sharepoint_sessions/
node_modules/
frontend-ng/node_modules/
frontend-ng/.angular/
frontend-ng/dist/
docs/status-screenshots/
knowledge-bases/*
**.db
src/models/

# Unnecessary code
benchmarking/
install.sh
tests/
.pre-commit-config.yaml

# Data
data/
!data/hkunlp_embeddings.npy
!data/url_suffixes.npy

# Secrets
**/secrets/

# ---- Python images only ----
# A BuildKit build of docker/Dockerfile.agentium-{backend,worker} reads this
# file instead of the root .dockerignore, so everything above is the root file
# verbatim (test_python_image_context keeps it so). Below: what the Python
# runtime never reads. docs/ itself stays — demo seeds and Sentinel read its
# Markdown and JSON — only its media and office exports go.
frontend-ng/
livekit-agent/
outputs/
presentations/
archive/
docs/evidence/
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.pdf
docs/**/*.pptx
docs/**/*.docx
docs/**/*.xlsx
docs/**/*.mp4
