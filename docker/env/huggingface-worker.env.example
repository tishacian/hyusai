# Dedicated hub-fetch env; copy outside version control, chmod 0600.
# Do not place its writer/deletion credentials in AGENTIUM_ENV_FILE.
DATABASE_URL=postgresql://agentium:change-me-postgres-password@agentium-pg:5432/agentium
CELERY_BROKER_URL=amqp://agentium-app:change-me-rabbitmq-password@agentium-rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_DEFAULT_QUEUE=cpu
CONNECTOR_SECRETS_FERNET_KEY=
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_S3_ENDPOINT_URL=http://agentium-minio:9000
OBJECT_STORE_S3_BUCKET=agentium-artifacts
OBJECT_STORE_S3_ACCESS_KEY=
OBJECT_STORE_S3_SECRET_KEY=
HF_S3_ACCESS_KEY=
HF_S3_SECRET_KEY=
HF_ALLOWED_ENDPOINTS=
HF_CACHE_MAX_BYTES=42949672960
HF_CACHE_MIN_FREE_BYTES=2147483648
HF_DISK_MIN_FREE_BYTES=10737418240
HF_IMPORT_TIMEOUT_SECONDS=7200
HF_IMPORT_LEASE_SECONDS=300
HF_DOWNLOAD_TIMEOUT_SECONDS=60
# Optional offline bundles. Public trust keys must also be set on API + CPU.
HF_BUNDLE_TRUST_KEYS_JSON={}
HF_BUNDLE_SIGNING_KEY_PATH=
HF_BUNDLE_SIGNING_KEY_ID=
# Optional retained-result purge role, scoped to workspaces/*/tabular/hub-artifacts/*.
HF_TABULAR_DELETE_ACCESS_KEY=
HF_TABULAR_DELETE_SECRET_KEY=
