# Agentium Docker runtime env.
# Copy to docker/env/agentium.vm.env on the VM and fill secrets there.
# Do not reuse backend/.env here: it is intentionally kept for systemd SFTP
# and host-local services while Docker containers use service DNS names.

APP_NAME=AI Orchestration Platform
APP_VERSION=1.0.0-demo
DEBUG=false
LOG_LEVEL=INFO
# Authorization-v2 remains shadow while the project id is empty. Set the
# numeric CI_PROJECT_ID only when the protected GitLab promotion gate is live.
AUTHORIZATION_V2_TRUSTED_OIDC_ISSUER=https://gitlab.com
AUTHORIZATION_V2_TRUSTED_PROJECT_ID=
AUTHORIZATION_V2_TRUSTED_REF=demo/agentic
INTELLIGENCE_SCHEDULER_ENABLED=false
INTELLIGENCE_SCHEDULER_INTERVAL_SECONDS=43200
INTELLIGENCE_BATCH_MAX_ARTICLES=20
INTELLIGENCE_BATCH_RETRY_SKIPPED=false
INTELLIGENCE_BATCH_SAFETY_CHECK_ENABLED=false

API_V1_PREFIX=/api/v1
AGENTIUM_POSTGRES_DB=agentium
AGENTIUM_POSTGRES_USER=agentium
AGENTIUM_POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://agentium:change-me-postgres-password@agentium-pg:5432/agentium

OPENAI_API_KEY=
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5

DEFAULT_VECTOR_DB_TYPE=qdrant
QDRANT_HOST=agentium-qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false
FAISS_PERSIST_DIRECTORY=/data/faiss_db
# Must equal QDRANT__SERVICE__READ_ONLY_API_KEY from the private Qdrant env.
QDRANT_API_KEY=change-me-qdrant-read-only-key-at-least-32-characters

KEYCLOAK_URL=https://agentium.papai.ai/kc
KEYCLOAK_URL_INTERNAL=http://agentium-kc:8080/kc
KEYCLOAK_REALM=papai-org
KEYCLOAK_CLIENT_ID=core-service
KEYCLOAK_RESOURCE_SERVER_ID=core-resource-server
KEYCLOAK_CLIENT_SECRET=

AGENTIUM_RABBITMQ_USER=agentium-app
AGENTIUM_RABBITMQ_PASSWORD=change-me-rabbitmq-password
CELERY_BROKER_URL=amqp://agentium-app:change-me-rabbitmq-password@agentium-rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_DEFAULT_QUEUE=cpu
CELERY_CONCURRENCY=2
ENABLE_P4_MAINTENANCE=false
P4_MAINTENANCE_INTERVAL_SECONDS=5
P4_MAINTENANCE_BATCH_SIZE=50
P4_MAINTENANCE_LEASE_SECONDS=60
DOCUMENT_INGEST_ASYNC_ENABLED=false
WORKER_EAGER_MODE=false
# Python recipe nodes (Flow Builder). Fail-closed by default: enable only on
# deployments that mount AGENTIUM_RECIPE_ENVS_PATH into the worker. The
# backend needs the flag for dispatch; only the worker needs the volume.
RECIPE_EXECUTION_ENABLED=false
RECIPE_ENVS_PATH=/data/recipe_envs
# Empty = default pip registry (PyPI). Workspace nodes may override per spec.
RECIPE_PIP_DEFAULT_INDEX_URL=
RECIPE_EXECUTION_DEFAULT_TIMEOUT_S=120
RECIPE_EXECUTION_MAX_TIMEOUT_S=600
RECIPE_EXECUTION_MEMORY_LIMIT_MB=1024
RECIPE_ENV_BUILD_TIMEOUT_S=600
# Storage governor: hourly sweep evicts LRU ready envs above the quota (down
# to the watermark), idle envs past the TTL, purges never-built pending rows
# nothing references, and caps the shared pip cache.
RECIPE_ENVS_MAX_TOTAL_BYTES=10737418240
RECIPE_ENVS_LOW_WATERMARK_BYTES=8589934592
RECIPE_ENVS_IDLE_TTL_DAYS=14
RECIPE_ENVS_PENDING_PURGE_HOURS=24
RECIPE_PIP_CACHE_MAX_BYTES=2147483648
RAG_RETRIEVAL_WORKER_ENABLED=false
RAG_RETRIEVAL_WORKER_TIMEOUT_SECONDS=120
RAG_SIMILARITY_THRESHOLD=0.2
RAG_SPARSE_BACKEND=auto
RAG_QDRANT_SPARSE_ENABLED=true
RAG_QDRANT_HYBRID_FUSION=rrf
RAG_QDRANT_ORACLE_HNSW_EF=32
RAG_QDRANT_CHAT_HNSW_EF=64
RAG_QDRANT_DEEP_HNSW_EF=128
RAG_QDRANT_QUANTIZED_SEARCH_ENABLED=true
# Hard-pin validated expert fiches ahead of regular docs at retrieval time.
# The per-workspace expert_review_required override (see migration 042) does the
# review disabling; KC_EXPERT_REVIEW_REQUIRED stays at its default (True).
RAG_EXPERT_FICHE_PIN_ENABLED=true
CHAT_STREAM_TIMEOUT_SECONDS=180
OPENAI_RESPONSES_API_ENABLED=false
OPENAI_RESPONSES_INCLUDE_REASONING_ENCRYPTED_CONTENT=true

DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_PROVIDER_PRIORITY=ppocr_service,tesseract_local
DOCUMENT_OCR_PPOCR_ENDPOINT_URL=
DOCUMENT_OCR_LANGUAGES=eng,fra
DOCUMENT_OCR_SCAN_DETECTION=true
DOCUMENT_OCR_FORCE_OCR=false
DOCUMENT_OCR_MIN_TEXT_CHARS_FOR_NATIVE_PDF=80
DOCUMENT_OCR_MIN_CONFIDENCE=0
DOCUMENT_OCR_TIMEOUT_SECONDS=30
DOCUMENT_OCR_RETRIES=2
DOCUMENT_OCR_RETRY_BACKOFF_MS=250
DOCUMENT_OCR_REQUIRED=false
DOCUMENT_OCR_OPENAI_VISION_ENABLED=false
DOCUMENT_OCR_OPENAI_MODEL=gpt-4o-mini
DOCUMENT_OCR_OPENAI_DETAIL=low
DOCUMENT_OCR_OPENAI_MAX_IMAGE_BYTES=5000000
DOCUMENT_OCR_OPENAI_ENRICH_MIN_CHARS=24
DOCUMENT_OCR_OPENAI_ENRICH_MIN_CONFIDENCE=0.45

VOICE_RUNTIME_DEFAULT_PROVIDER=cascade_openai
VOICE_RUNTIME_ALLOWED_PROVIDERS=cascade_openai,openai_realtime,local_stt,local_tts,local_realtime,realtime_gpu
VOICE_RUNTIME_FALLBACK_PROVIDERS=cascade_openai
VOICE_REALTIME_DEFAULT_TRANSPORT=backend_ws
VOICE_REALTIME_WEBRTC_ENABLED=false
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
OPENAI_REALTIME_EPHEMERAL_TTL_SECONDS=600
LOCAL_STT_ENDPOINT_URL=
LOCAL_TTS_ENDPOINT_URL=
LOCAL_REALTIME_ENDPOINT_URL=

LIVEKIT_ENABLED=false
LIVEKIT_IMAGE_TAG=v1.12.0
LIVEKIT_URL=wss://livekit.agentium.papai.ai
LIVEKIT_INTERNAL_URL=http://agentium-livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-chars
LIVEKIT_WEBHOOK_API_KEY=devkey
LIVEKIT_WEBHOOK_API_SECRET=change-me-livekit-secret-at-least-32-chars
LIVEKIT_KEYS=devkey: change-me-livekit-secret-at-least-32-chars
LIVEKIT_AGENT_DISPATCH_URL=http://agentium-livekit-agent:8090/dispatch
LIVEKIT_AGENT_CONNECT_ATTEMPTS=6
LIVEKIT_AGENT_CONNECT_RETRY_MS=500
LIVEKIT_AGENT_CONNECT_MAX_RETRY_MS=3000
LIVEKIT_VOICE_GATEWAY_WS_URL=ws://agentium-backend:8000/api/v1/voice/sessions
LIVEKIT_VOICE_BRIDGE_TOKEN_TTL_SECONDS=3600
LIVEKIT_HTTP_HOST_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_RANGE_START=50000
LIVEKIT_RTC_UDP_RANGE_END=50100
LIVEKIT_RTC_BIND_HOST=0.0.0.0
# Optional P3 scale/governance switches. Leave Redis empty for the single-node
# VM demo. Use agentium-livekit-redis:6379 only with --profile realtime-scale.
LIVEKIT_REDIS_ADDRESS=
LIVEKIT_REDIS_USERNAME=
LIVEKIT_REDIS_PASSWORD=
LIVEKIT_REDIS_DB=
LIVEKIT_TURN_MODE=external_or_none
LIVEKIT_AGENTS_MODE=sidecar_http_bridge
LIVEKIT_EGRESS_ENABLED=false

OBJECT_STORE_BACKEND=local
OBJECT_STORE_BASE_PATH=/data/object_store
OBJECT_STORE_S3_BUCKET=agentium-artifacts
OBJECT_STORE_S3_ENDPOINT_URL=http://agentium-minio:9000
OBJECT_STORE_S3_ACCESS_KEY=agentium-app
OBJECT_STORE_S3_SECRET_KEY=change-me-agentium-app-password
AGENTIUM_FRONTEND_HOST_PORT=8081
AGENTIUM_MINIO_API_PORT=9000
AGENTIUM_MINIO_CONSOLE_PORT=9001
AGENTIUM_MINIO_ROOT_USER=agentium-root
AGENTIUM_MINIO_ROOT_PASSWORD=change-me-minio-root-password
AGENTIUM_MINIO_BUCKET=agentium-artifacts
# These three host paths are mandatory in production. They preserve the
# existing /dev/sda1, /dev/sdb and /dev/sdc layout during a safe rollout.
AGENTIUM_FAISS_PATH=/home/ubuntu/omnirag/backend/faiss_db
AGENTIUM_OBJECT_STORE_PATH=/srv/agentium-data/object_store
AGENTIUM_SECURE_DEPOSIT_PATH=/home/ubuntu/omnirag/backend/data/secure_deposit
# Host directory backing /data/recipe_envs on the Celery worker (venv store +
# shared pip cache for Python recipe nodes).
AGENTIUM_RECIPE_ENVS_PATH=/srv/agentium-data/recipe_envs
# Required production storage identity. These exact values bind MinIO and
# Qdrant to the pre-created local-driver volumes backed by /dev/sdb.
AGENTIUM_MINIO_VOLUME=agentium_minio_block
AGENTIUM_MINIO_VOLUME_EXTERNAL=true
AGENTIUM_QDRANT_VOLUME=agentium_qdrant_block
AGENTIUM_QDRANT_SNAPSHOT_PATH=/srv/agentium-data/qdrant-snapshots
AGENTIUM_SFTP_BIND_HOST=127.0.0.1
AGENTIUM_SFTP_HOST_PORT=2223
BM25_REBUILD_INLINE_MAX_CHUNKS=50000

SECURE_DEPOSIT_PUBLIC_BASE_URL=https://agentium.papai.ai
SECURE_DEPOSIT_SESSION_SECRET=
SECURE_DEPOSIT_SESSION_TTL_SECONDS=7200
SECURE_DEPOSIT_DEFAULT_MAX_FILE_SIZE_MB=100
SECURE_DEPOSIT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,md,png,jpg,jpeg,tif,tiff,webp
SECURE_DEPOSIT_STORAGE_DIR=/data/secure_deposit
SECURE_DEPOSIT_SFTP_HOST=0.0.0.0
SECURE_DEPOSIT_SFTP_PORT=2222
SECURE_DEPOSIT_SFTP_HOST_KEY_PATH=/data/secure_deposit/sftp_host_key
SECURE_DEPOSIT_SFTP_TEMP_DIR=/data/secure_deposit/_sftp_uploads

IAM_GENERIC_ENGINE=false

# Optional comma-separated existing accounts to auto-provision as Octocity
# workspace owners. Empty skips auto-provisioning and preserves memberships.
OCTOCITY_OWNER_EMAILS=

SHAREPOINT_SESSION_DIR=/data/sharepoint_sessions
SHAREPOINT_DOWNLOAD_DIR=/data/sharepoint_downloads
SHAREPOINT_CONNECTOR_FERNET_KEY=
SHAREPOINT_CONNECTOR_REQUIRE_ENCRYPTION=true

SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Agentium
