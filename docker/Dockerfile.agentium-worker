FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        libreoffice-calc \
        libreoffice-writer \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX_URL
RUN : "${PIP_INDEX_URL:?PIP_INDEX_URL is required}"

COPY backend/requirements.txt /tmp/requirements/
RUN pip install --no-cache-dir \
    --index-url=${PIP_INDEX_URL} \
    -r /tmp/requirements/requirements.txt

# Offline RAGET only. Its disposable subprocesses do not share tenant globals.
# Keep the API image and normal ingestion workers free of this optional SDK.
COPY backend/requirements_giskard.txt /tmp/requirements/
ARG INSTALL_GISKARD_RAGET=false
RUN if [ "$INSTALL_GISKARD_RAGET" = "true" ]; then \
      pip install --no-cache-dir --index-url=${PIP_INDEX_URL} \
        -r /tmp/requirements/requirements_giskard.txt; \
    fi

# Deep-retrieval jobs (run_deep_retrieval) execute the cross-encoder rerank
# stage in this worker, so it needs torch + transformers like the backend.
# CPU-only torch index avoids the multi-GB CUDA build from PyPI.
#
# torchvision is the +cpu peer transformers assumes alongside torch; see the
# backend image for why its absence broke deserialising a model. Batch scoring
# loads artifacts in this process too, so it needs the same environment.
RUN pip install --no-cache-dir torch torchvision \
        --index-url=https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        --index-url=${PIP_INDEX_URL} \
        "transformers>=4.41.0"

ARG USERNAME=agentium
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid "$USER_GID" "$USERNAME" \
    && useradd --uid "$USER_UID" --gid "$USER_GID" --create-home "$USERNAME"

WORKDIR /app

COPY --chown=$USERNAME:$USERNAME . .

# Qualify actual SDK objects offline; pip metadata alone misses Arrow API drift.
RUN if [ "$INSTALL_GISKARD_RAGET" = "true" ]; then \
      pip check && PYTHONPATH=/app/backend python backend/scripts/qualify_giskard_raget.py; \
    fi

RUN chmod +x ./run_celery.sh \
    && mkdir -p /data/object_store /data/recipe_envs /app/vector_store \
    && chown -R "$USERNAME":"$USERNAME" /data /app/vector_store

USER $USERNAME

ENV PYTHONPATH=/app/backend:/app
WORKDIR /app

ARG AGENTIUM_IMAGE_REVISION=unknown
ENV AGENTIUM_IMAGE_REVISION=${AGENTIUM_IMAGE_REVISION}
LABEL org.opencontainers.image.revision="${AGENTIUM_IMAGE_REVISION}"

CMD ["./run_celery.sh"]
