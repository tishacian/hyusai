# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.cache/

# Jupyter Notebook
.ipynb_checkpoints

# Spyder project settings
.spyderproject
.spyproject

# PyCharm
.idea/

# Generated by MacOS
.DS_Store

# Cursor IDE / agent local state (debug logs, session artifacts)
.cursor/

# Stray uv lockfile (project standardizes on poetry.lock + requirements/*.txt)
uv.lock

# MS Office temporary lock files (e.g. ~$document.docx), incl. nested paths
~$*

# Generated by Windows
Thumbs.db

# Environments
.env
.venv
env/
venv/
ENV/

# Generated vector database
vector_store/*
knowledge-bases/*
.safetensors
.json
*.db

# Models
src/models

# Data
data/
!data/hkunlp_embeddings.npy
!data/url_suffixes.npy
.trash
pdfs/
*.mdc
*.zip

# Runtime / deployment
server.log
uploads/

# Local QA / demo capture artifacts
docs/status-screenshots/
scripts/playwright/docs/
docs/~$*

# One-off Playwright probes and capture retries used during live demo QA.
# Durable QA harnesses should be named qa_*.mjs and reviewed before commit.
scripts/playwright/probe_*.mjs
scripts/playwright/debug_*.mjs
scripts/playwright/capture_aya_screens.mjs
scripts/playwright/capture_demo_screens*.mjs

# Secrets
*/secrets/

# SharePoint OTP connector
# Cached session blobs contain live cookies (even when encrypted at rest,
# they are still a secret that must not reach the repo).
.sharepoint_sessions/
# Local ingestion output used during CLI runs.
downloads/

# Node modules installed under helper scripts (playwright local harness).
node_modules/

# Demo deck binary artifacts (kept local; the build_deck.py generator is tracked).
demo-assets/**/*.png
demo-assets/**/*.pptx

# PIH product doc build outputs (generators under docs/render/ are tracked).
docs/render/out/*.docx
docs/render/assets/diagrams/

# Scala / SBT / Metals build & BSP artifacts (root)
/target/
/.bsp/
