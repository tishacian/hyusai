# REQUIRED
OPENAI_API_KEY=

# Application
APP_NAME="AI Orchestration Platform"
DEBUG=false

# LLM defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Database
DATABASE_URL=sqlite:///./demo.db

# Vector store
FAISS_PERSIST_DIRECTORY=./faiss_db

# Logging
LOG_LEVEL=INFO
