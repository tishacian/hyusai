# REQUIRED
OPENAI_API_KEY=

# Application
APP_NAME="AI Orchestration Platform"
DEBUG=false

# LLM defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Database (PostgreSQL recommended; SQLite fallback for solo dev)
DATABASE_URL=postgresql://agentium:agentium@localhost:5432/agentium
# DATABASE_URL=sqlite:///./demo.db

# Vector store
FAISS_PERSIST_DIRECTORY=./faiss_db
CHROMA_PERSIST_DIRECTORY=./chroma_db
# qdrant is the default. faiss/chroma are kept for explicit legacy/migration use.
DEFAULT_VECTOR_DB_TYPE=qdrant

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=
QDRANT_HTTPS=false

# Retrieval boost / hybrid Qdrant
RAG_SIMILARITY_THRESHOLD=0.2
RAG_SPARSE_BACKEND=auto
RAG_QDRANT_SPARSE_ENABLED=true
RAG_QDRANT_HYBRID_FUSION=rrf
RAG_QDRANT_ORACLE_HNSW_EF=32
RAG_QDRANT_CHAT_HNSW_EF=64
RAG_QDRANT_DEEP_HNSW_EF=128
RAG_QDRANT_QUANTIZED_SEARCH_ENABLED=true

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=papai-org
KEYCLOAK_CLIENT_ID=core-service
# KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_RESOURCE_SERVER_ID=core-resource-server

# Voice realtime STT (LiveKit sidecar -> gpt-realtime-whisper)
# Master switch for streaming transcription in the knowledge-capture lane.
# When on, the LiveKit sidecar transcribes the published mic track in realtime
# instead of the browser re-uploading growing WebM buffers per turn.
VOICE_REALTIME_STT_ENABLED=false
# Optional comma-separated workspace slugs allowlist (empty = all LiveKit workspaces).
VOICE_REALTIME_STT_WORKSPACE_SLUGS=
# Latency/accuracy tradeoff: minimal|low|medium|high|xhigh
VOICE_REALTIME_STT_DELAY=low

# Logging
LOG_LEVEL=INFO
