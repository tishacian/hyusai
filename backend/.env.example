# REQUIRED
OPENAI_API_KEY=

# Application
APP_NAME="AI Orchestration Platform"
DEBUG=false

# LLM defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Database
DATABASE_URL=sqlite:///./demo.db

# Vector store
FAISS_PERSIST_DIRECTORY=./faiss_db
CHROMA_PERSIST_DIRECTORY=./chroma_db
# faiss | chroma | qdrant
DEFAULT_VECTOR_DB_TYPE=faiss

# Qdrant (when DEFAULT_VECTOR_DB_TYPE=qdrant or app setting ragVectorDBType=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=
QDRANT_HTTPS=false

# Logging
LOG_LEVEL=INFO
