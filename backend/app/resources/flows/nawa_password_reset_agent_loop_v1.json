{
  "artifact": "nawa_password_reset_agent_loop_v1",
  "description": "Overlay / twin of NAWA Password Reset for AgentLoop L0–L1. Does not replace the seeded production artifact.",
  "overlay_decide": {
    "schema_version": 3,
    "nodes": [
      {
        "id": "source.request",
        "type": "source",
        "kind": "source",
        "label": "Trigger",
        "outputs": [{ "name": "goal", "schema": "string" }]
      },
      {
        "id": "task.decide_next",
        "type": "skill",
        "kind": "task",
        "label": "Decide next",
        "config": {
          "skill_slug": "decide_next_v1",
          "params": {
            "visible_skills": [
              { "slug": "azure_llm_v1", "purpose": "Classify ITSD intent", "side_effect_class": "read", "privilege_tier": "recommend" },
              { "slug": "audit_log_v1", "purpose": "Write audit ledger", "side_effect_class": "write", "privilege_tier": "act_with_approval" }
            ],
            "confidence_floor": 0.55
          }
        }
      },
      {
        "id": "decision.route",
        "type": "decision",
        "kind": "decision",
        "label": "Route",
        "config": {
          "passthrough_inputs": ["next_skill", "needs_human", "exit", "done"],
          "branches": [
            { "label": "ask_human", "condition": "needs_human == True or exit == 'ask_human'" },
            { "label": "blocked", "condition": "exit == 'blocked' or exit == 'policy_block' or exit == 'budget'" },
            { "label": "classify", "condition": "next_skill == 'azure_llm_v1'" },
            { "label": "audit", "condition": "next_skill == 'audit_log_v1'" }
          ],
          "default_branch": "blocked"
        }
      },
      {
        "id": "task.classify",
        "type": "skill",
        "kind": "task",
        "label": "Classify",
        "config": { "skill_slug": "azure_llm_v1" }
      },
      {
        "id": "task.audit",
        "type": "skill",
        "kind": "task",
        "label": "Audit",
        "config": { "skill_slug": "audit_log_v1" }
      },
      {
        "id": "hitl.gate",
        "type": "hitl",
        "kind": "hitl",
        "label": "Human gate",
        "config": { "prompt": "Approve the next AgentLoop step?", "prompt_kind": "choice" }
      },
      {
        "id": "sink.result",
        "type": "sink",
        "kind": "sink",
        "label": "Output"
      }
    ],
    "edges": [
      { "from": "source.request", "to": "task.decide_next", "kind": "data" },
      { "from": "task.decide_next", "to": "decision.route", "kind": "data" },
      { "from": "decision.route", "to": "hitl.gate", "kind": "branch", "branch_label": "ask_human" },
      { "from": "decision.route", "to": "sink.result", "kind": "branch", "branch_label": "blocked" },
      { "from": "decision.route", "to": "task.classify", "kind": "branch", "branch_label": "classify" },
      { "from": "decision.route", "to": "task.audit", "kind": "branch", "branch_label": "audit" },
      { "from": "task.classify", "to": "sink.result", "kind": "data" },
      { "from": "task.audit", "to": "sink.result", "kind": "data" },
      { "from": "hitl.gate", "to": "sink.result", "kind": "control" }
    ]
  },
  "flow_definition": {
    "schema_version": 3,
    "nodes": [
      {
        "id": "source.request",
        "type": "source",
        "kind": "source",
        "label": "Trigger"
      },
      {
        "id": "loop.itsd",
        "type": "agent_loop",
        "kind": "agent_loop",
        "label": "ITSD agent loop",
        "config": {
          "skill_slug": "decide_next_v1",
          "decide_skill": "decide_next_v1",
          "skill_allowlist": ["azure_llm_v1", "audit_log_v1", "semantic_search_v1"],
          "confidence_floor": 0.55,
          "privilege_tier": "act_with_approval",
          "on_budget": "exit",
          "budget": { "max_turns": 6 },
          "goal": {
            "objective": "Reset the requester AD password under ITSD policy",
            "done_when": ["audit_log_v1"],
            "status": "active"
          }
        }
      },
      {
        "id": "sink.result",
        "type": "sink",
        "kind": "sink",
        "label": "Output"
      }
    ],
    "edges": [
      { "from": "source.request", "to": "loop.itsd", "kind": "data" },
      { "from": "loop.itsd", "to": "sink.result", "kind": "data" }
    ]
  }
}
