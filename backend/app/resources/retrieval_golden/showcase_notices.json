      "expected_evidence_terms": ["PMP-700", "relief valve", "735 bar"],
      "expected_intent": "content_search",
      "answer_profile": "precise_fact",
      "expected_prompt_type": "factual",
      "latency_profile": "balanced",
      "language": "en"
    },
