{
  "request_key": "r1-live-qualification-4",
  "name": "PIH BRD qualification",
  "objective": "Propose a documentary synthesis flow for PIH idea SPARK-089 regrade requests that ingests supplied excerpts, extracts required facts (current/proposed job title and grade, effective date), selects supporting passages, synthesizes a reviewer-ready draft, performs HITL review, and outputs a structured result without making any HR decisions.",
  "flow_definition": {
    "schema_version": 3,
    "io_mode": "strict",
    "nodes": [
      {
        "id": "n1_source",
        "type": "source",
        "kind": "source",
        "config": {
          "ingress_kind": "manual",
          "input_schema": {
            "type": "object",
            "properties": {
              "doc_text": {
                "type": "string",
                "description": "Concatenated or excerpted regrade transaction documents for PIH SPARK-089."
              },
              "requested_fields": {
                "type": "string",
                "description": "Fields the summary must cover (e.g., current/proposed job title and grade, effective date, citations)."
              },
              "citation_policy": {
                "type": "string",
                "description": "Citation or excerpt ID policy for references."
              }
            },
            "required": [
              "doc_text"
            ],
            "additionalProperties": false
          },
          "outputs": [
            {
              "name": "doc_text",
              "schema": "string",
              "required": true
            },
            {
              "name": "requested_fields",
              "schema": "string",
              "required": false
            },
            {
              "name": "citation_policy",
              "schema": "string",
              "required": false
            }
          ]
        }
      },
      {
        "id": "n2_extract",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@extract_facts",
          "inputs_map": {
            "text": {
              "node_id": "n1_source",
              "path": [
                "doc_text"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "n3_support",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@select_support",
          "inputs_map": {
            "text": {
              "node_id": "n1_source",
              "path": [
                "doc_text"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "n4_synth",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@synthesize_summary",
          "inputs_map": {
            "text": {
              "node_id": "n2_extract",
              "path": [
                "completion"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "n5_hitl",
        "type": "hitl",
        "kind": "hitl",
        "config": {
          "prompt": "Review the synthesized draft for PIH idea SPARK-089. Check: (1) Only supplied facts are stated; any missing requested facts are explicitly marked absent. (2) Include current and proposed job title and grade, and effective date if supplied. (3) Provide citation identifiers for supporting passages when required by the BRD. (4) Do not approve, reject, update, or recommend any HR decision. Provide comments for clarification requests."
        }
      },
      {
        "id": "n6_sink",
        "type": "sink",
        "kind": "sink",
        "config": {
          "output_schema": {
            "type": "object",
            "properties": {
              "draft": {
                "type": "string",
                "description": "Reviewer-ready executive summary synthesis."
              },
              "extraction": {
                "type": "string",
                "description": "Extracted factual elements including current/proposed titles and grades, effective date, and flagged missing fields."
              },
              "support": {
                "type": "string",
                "description": "Selected supporting passages and citation identifiers from supplied excerpts."
              }
            },
            "required": [
              "draft",
              "extraction",
              "support"
            ],
            "additionalProperties": false
          },
          "inputs_map": {
            "draft": {
              "node_id": "n4_synth",
              "path": [
                "completion"
              ],
              "required": true
            },
            "extraction": {
              "node_id": "n2_extract",
              "path": [
                "completion"
              ],
              "required": true
            },
            "support": {
              "node_id": "n3_support",
              "path": [
                "completion"
              ],
              "required": true
            }
          }
        }
      }
    ],
    "edges": [
      {
        "from": "n1_source",
        "to": "n2_extract",
        "kind": "data"
      },
      {
        "from": "n1_source",
        "to": "n3_support",
        "kind": "data"
      },
      {
        "from": "n2_extract",
        "to": "n4_synth",
        "kind": "data"
      },
      {
        "from": "n4_synth",
        "to": "n5_hitl",
        "kind": "data"
      },
      {
        "from": "n3_support",
        "to": "n5_hitl",
        "kind": "data"
      },
      {
        "from": "n4_synth",
        "to": "n6_sink",
        "kind": "data"
      },
      {
        "from": "n2_extract",
        "to": "n6_sink",
        "kind": "data"
      },
      {
        "from": "n3_support",
        "to": "n6_sink",
        "kind": "data"
      }
    ]
  },
