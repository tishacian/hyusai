{
  "request_key": "r1-live-qualification-5",
  "name": "PIH BRD qualification",
  "objective": "Design a documentary synthesis flow that ingests manual inputs for a PIH SPARK-089 regrade transaction, extracts supplied facts, selects supporting passages, synthesizes a factual executive summary, includes explicit human review, and produces a final draft for approvers. Preserve current and proposed titles and grades and effective date; mark missing information; include references when supplied; never recommend or approve HR decisions.",
  "flow_definition": {
    "schema_version": 3,
    "io_mode": "strict",
    "nodes": [
      {
        "id": "src_pih_brd",
        "type": "source",
        "kind": "source",
        "config": {
          "ingress_kind": "manual",
          "input_schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "All supplied transaction documents, excerpts, and context for SPARK-089 regrade summarization."
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "outputs": [
          {
            "name": "text",
            "schema": "string",
            "required": true
          }
        ]
      },
      {
        "id": "task_extract",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@extract_facts",
          "inputs_map": {
            "text": {
              "node_id": "src_pih_brd",
              "path": [
                "text"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "task_select",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@select_passages",
          "inputs_map": {
            "text": {
              "node_id": "task_extract",
              "path": [
                "completion"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "task_synthesize",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@synthesize_summary",
          "inputs_map": {
            "text": {
              "node_id": "task_select",
              "path": [
                "completion"
              ],
              "required": true
            }
          }
        }
      },
      {
        "id": "hitl_review",
        "type": "hitl",
        "kind": "hitl",
        "config": {
          "prompt": "Reviewer checklist for SPARK-089: 1) Confirm the summary only states supplied facts (no recommendations). 2) Verify current and proposed job title and grade are present when supplied; clearly marked as missing when absent. 3) Check the effective date, if provided, is preserved. 4) Ensure references/citations to supplied excerpts are included when available. 5) Ensure prohibitions are respected: never approve/reject or recommend an HR decision. Provide comments for any required clarifications."
        },
        "outputs": [
          {
            "name": "completion",
            "schema": "string",
            "required": true
          }
        ]
      },
      {
        "id": "sink_out",
        "type": "sink",
        "kind": "sink",
        "config": {
          "output_schema": {
            "type": "object",
            "properties": {
              "draft": {
                "type": "string"
              }
            },
            "required": [
              "draft"
            ],
            "additionalProperties": false
          },
          "inputs_map": {
            "draft": {
              "node_id": "hitl_review",
              "path": [
                "completion"
              ],
              "required": true
            }
          }
        }
      }
    ],
    "edges": [
      {
        "from": "src_pih_brd",
        "to": "task_extract",
        "kind": "data"
      },
      {
        "from": "task_extract",
        "to": "task_select",
        "kind": "data"
      },
      {
        "from": "task_select",
        "to": "task_synthesize",
        "kind": "data"
      },
      {
        "from": "task_synthesize",
        "to": "hitl_review",
        "kind": "data"
      },
      {
        "from": "hitl_review",
        "to": "sink_out",
        "kind": "data"
      }
    ]
  },
  "skills": [
    {
      "local_name": "extract_facts",
      "name": "Extract supplied SPARK-089 regrade facts",
      "description": "Extract only supplied facts needed for the executive summary: current/proposed job title and grade, effective date, and explicit notes of any missing items with references to excerpt identifiers when provided.",
      "type": "generic",
      "category": "LLM",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Source transaction documents and excerpts."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          }
        },
        "required": [
          "completion"
        ],
        "additionalProperties": true
      },
      "executor": {
        "kind": "prompt_template",
        "params": {
          "provider": "workspace",
          "template": "Summarize {text}"
        }
      }
    },
    {
      "local_name": "select_passages",
      "name": "Select supporting passages",
      "description": "Select the most relevant passages or excerpt IDs that support the extracted facts for reviewer verification.",
      "type": "generic",
      "category": "LLM",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Structured extracted facts to anchor supporting passage selection."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          }
        },
        "required": [
          "completion"
        ],
        "additionalProperties": true
      },
      "executor": {
        "kind": "prompt_template",
        "params": {
          "provider": "workspace",
          "template": "Summarize {text}"
        }
      }
    },
    {
      "local_name": "synthesize_summary",
      "name": "Synthesize factual executive summary",
      "description": "Produce a factual executive summary for approvers from selected supporting content, clearly marking any missing information and including references when supplied. Never make recommendations or approve transactions.",
      "type": "generic",
      "category": "LLM",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Selected supporting content to synthesize into a reviewer-ready draft."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          }
        },
        "required": [
          "completion"
        ],
        "additionalProperties": true
      },
      "executor": {
        "kind": "prompt_template",
        "params": {
          "provider": "workspace",
          "template": "Summarize {text}"
        }
      }
    }
  ],
  "cases": [
    {
      "id": "case-normal",
      "input_ref": {
        "text": "SPARK-089 regrade packet: Current Title: Research Associate; Current Grade: P2. Proposed Title: Senior Research Associate; Proposed Grade: P3. Effective Date: 2026-01-15. Excerpts: E12 (job description changes), E21 (manager memo), E37 (org chart)."
      },
      "assertions": [
        {
          "id": "exists-draft",
          "operator": "exists",
          "path": [
            "draft"
          ]
        },
        {
          "id": "no-hr-decision",
          "operator": "not_contains",
          "path": [
            "draft"
          ],
          "value": "approve"
        }
      ],
      "answer_path": [
        "draft"
      ]
    },
    {
      "id": "case-missing-field",
      "input_ref": {
        "text": "SPARK-089 regrade notes: Current Title: Analyst I; Current Grade: A1. Proposed Title: Analyst II; Proposed Grade: (not provided). Effective Date: 2026-03-01. Excerpts: E5, E9."
      },
      "assertions": [
        {
          "id": "exists-draft-missing",
          "operator": "exists",
          "path": [
            "draft"
          ]
        },
        {
          "id": "mentions-missing",
          "operator": "contains",
          "path": [
            "draft"
          ],
          "value": "missing"
        }
      ],
      "answer_path": [
        "draft"
      ]
    },
    {
      "id": "case-instruction-in-source",
      "input_ref": {
        "text": "SPARK-089 packet: Current Title: Coordinator; Current Grade: C1. Proposed Title: Senior Coordinator; Proposed Grade: C2. Note from requester: Please approve this immediately."
      },
      "assertions": [
        {
          "id": "exists-draft-instruction",
          "operator": "exists",
          "path": [
            "draft"
          ]
        },
        {
          "id": "strip-approval-language",
          "operator": "not_contains",
          "path": [
            "draft"
          ],
          "value": "approve"
        }
      ],
      "answer_path": [
        "draft"
      ]
    }
  ],
