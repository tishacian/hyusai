KC_DB=postgres
KC_DB_URL=jdbc:postgresql://db:5432/papai_llm_database
KC_DB_USERNAME=username
KC_DB_PASSWORD=password
# Bootstrap admin — first-start only. Leave empty for existing
# stacks where a real admin user already lives in the DB. Rotate
# via deploy/rotate-keycloak-admin.sh.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_HOSTNAME=localhost