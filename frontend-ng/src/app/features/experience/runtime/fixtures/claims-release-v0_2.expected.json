              "id": "case_prediction",
              "props": {
                "title": "Conseil de priorité du modèle",
                "density": "compact",
                "predictionContract": {
                  "schema_version": 1,
                  "model_id": "2e71ce6f-800f-4d02-b59e-498e40fe48eb",
                  "model_version": 5,
                  "task": "classification",
                  "target": "resolution_over_72h",
                  "positive_label": "1",
                  "value_column": "prediction",
                  "score_column": "score_1",
                  "label": "Risque de résolution au-delà de 72 h",
                  "unit": "probability",
                  "order": "descending",
                  "max_age_seconds": 3600,
                  "bands": [
                    {
                      "key": "low",
                      "label": "Standard",
                      "min": 0
                    },
                    {
                      "key": "medium",
                      "label": "À surveiller",
                      "min": 0.35
                    },
                    {
                      "key": "high",
                      "label": "Prioritaire",
                      "min": 0.6
                    }
                  ]
                },
                "dataBinding": {
                  "source": "run-output",
                  "componentId": "investigation",
                  "nodeId": "sav.context",
                  "selector": "model_advice"
                }
              }
            },
            {
              "type": "result",
              "id": "result",
              "props": {
                "sourceComponentId": "investigation"
              }
            },
            {
              "type": "evidence",
              "id": "evidence",
              "props": {
                "sourceComponentId": "investigation"
              }
            },
            {
