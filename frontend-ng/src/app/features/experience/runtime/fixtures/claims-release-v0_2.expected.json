                      "RC-1044": "RC-1044",
                      "RC-5001": "RC-5001",
                      "RC-5002": "RC-5002",
                      "RC-5003": "RC-5003"
                    }
                  }
                }
              }
            },
            {
              "type": "runtime_status",
              "id": "state",
              "props": {
                "sourceComponentId": "investigation"
              }
            },
            {
