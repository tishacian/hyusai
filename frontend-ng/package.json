{
  "name": "agentium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build -c production",
    "check:performance": "ng build -c production --stats-json && node scripts/check-core-performance.mjs",
    "check:core-release": "node scripts/run-core-release-gates.mjs",
    "check:ui-chrome": "node scripts/check-ui-chrome.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:nav-links": "node scripts/check-nav-links.mjs --fail-closed",
    "check:nav-links:report": "node scripts/check-nav-links.mjs",
    "lint": "ng lint",
    "test": "ng test",
    "test:unit": "node scripts/run-unit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@foblex/flow": "^18.6.1",
    "@foblex/flow-dagre-layout": "^18.6.1",
    "@ngrx/signals": "^20.0.0",
    "chart.js": "~4.4.0",
    "codemirror": "^6.0.2",
    "livekit-client": "^2.19.1",
    "lucide-angular": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "ng2-charts": "^8.0.0",
    "ngx-extended-pdf-viewer": "^28.0.3",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
