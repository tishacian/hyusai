# GitLab HTTP backend. CI fills these from CI_* variables.
# terraform init -backend-config=backend.hcl
address        = "https://gitlab.example/api/v4/projects/0/terraform/state/agentium-instance"
lock_address   = "https://gitlab.example/api/v4/projects/0/terraform/state/agentium-instance/lock"
unlock_address = "https://gitlab.example/api/v4/projects/0/terraform/state/agentium-instance/lock"
username       = "gitlab-ci-token"
# password     = "<CI_JOB_TOKEN or personal token — never commit>"
lock_method    = "POST"
unlock_method  = "DELETE"
retry_wait_min = 5
