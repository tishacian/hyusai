          },
          "on_budget": "exit",
          "privilege_tier": "recommend",
          "inputs_map": {
            "objective": {
              "node_id": "source_request",
              "path": [
                "objective"
              ],
              "required": true
            },
            "query": {
              "node_id": "source_request",
              "path": [
                "objective"
              ],
              "required": true
            }
          }
        },
        "outputs": [
          {
            "name": "goal",
            "schema": "object",
            "required": true
          },
          {
            "name": "observations",
            "schema": "array",
            "required": true
          },
          {
            "name": "exit",
            "schema": "string",
            "required": true
          },
          {
            "name": "turns",
            "schema": "integer",
            "required": true
          },
          {
            "name": "privilege_tier",
            "schema": "string",
            "required": true
          },
          {
            "name": "visible_skills",
            "schema": "array",
            "required": true
          }
        ]
      },
      {
        "id": "synthesis_draft",
        "type": "task",
        "kind": "task",
        "config": {
          "skill_slug": "@synthesis_briefing_v1",
          "inputs_map": {
            "objective": {
              "node_id": "source_request",
              "path": [
                "objective"
              ],
              "required": true
            },
            "observations": {
              "node_id": "investigation_loop",
              "path": [
                "observations"
              ],
              "required": true
            }
          }
        },
        "outputs": [
          {
            "name": "completion",
            "schema": "string",
            "required": true
          }
        ]
      },
      {
        "id": "review_hitl",
        "type": "hitl",
        "kind": "hitl",
        "config": {
          "prompt": "Operator review required. Verify the draft briefing against cited source passages and mandate constraints.\nInstructions for reviewer:\n- Check that every factual claim is supported by citations from the retrieved notices/history. Missing facts must be stated as missing.\n- Confirm that operating limits come from notices; durations come from the Operational Analysis history (NF-01..NF-04).\n- Ensure the draft refuses any requests to change equipment states, close orders, or authorize work.\n- If evidence is missing or incorrect, reject and request clarification or a focused retry path.\nReference answer: The reviewer examines the synthesized draft and its evidence, then makes an explicit decision. The system records approved=false, rejected=true, decision_status=\"rejected\" when the reviewer rejects. The Run must wait for this explicit human action.",
          "reference_answer": "Reviewer inspects the draft and its citations, determines it is not acceptable, and explicitly rejects it. The recorded outcome must set: approved=false, rejected=true, decision_status=\"rejected\".",
          "decision_status": "pending"
        },
        "outputs": [
          {
            "name": "approved",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "rejected",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "decision_status",
            "schema": "string",
            "required": true
          }
        ]
      },
      {
        "id": "final_sink",
        "type": "sink",
        "kind": "sink",
        "config": {
          "output_schema": {
            "type": "object",
            "properties": {
              "draft": {
                "type": "string"
              },
              "approved": {
                "type": "boolean"
              },
              "rejected": {
                "type": "boolean"
              },
              "decision_status": {
                "type": "string"
              }
            },
            "required": [
              "draft",
              "approved",
              "rejected",
              "decision_status"
            ],
            "additionalProperties": true
          },
          "inputs_map": {
            "draft": {
              "node_id": "synthesis_draft",
              "path": [
                "completion"
              ],
              "required": true
            },
            "approved": {
              "node_id": "review_hitl",
              "path": [
                "approved"
              ],
              "required": true
            },
            "rejected": {
              "node_id": "review_hitl",
              "path": [
                "rejected"
              ],
              "required": true
            },
            "decision_status": {
              "node_id": "review_hitl",
              "path": [
                "decision_status"
              ],
              "required": true
            }
          }
        },
        "outputs": [
          {
            "name": "draft",
            "schema": "string",
            "required": true
          },
          {
            "name": "approved",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "rejected",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "decision_status",
            "schema": "string",
            "required": true
          }
        ]
      }
    ],
