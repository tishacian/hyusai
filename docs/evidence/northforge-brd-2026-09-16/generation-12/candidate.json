{
  "name": "intervention_preparation live worker",
  "objective": "Prepare a source-backed briefing with tool-mediated retrieval, explicit refusals for out-of-mandate requests, and mandatory human review before publication.",
  "flow_definition": {
    "schema_version": 3,
    "io_mode": "strict",
    "nodes": [
      {
        "id": "source_request",
        "type": "source",
        "kind": "source",
        "config": {
          "ingress_kind": "manual",
          "input_schema": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "objective"
            ],
            "additionalProperties": false
          }
