        "id": "hitl_review",
        "type": "hitl",
        "kind": "hitl",
        "config": {
          "prompt": "Please review the drafted intervention briefing for accuracy, mandate compliance, and evidence:\n- Verify all stated operating limits come from notices; verify order durations come from history.\n- Confirm cited passages are present in the retrieved evidence and identifiers are preserved.\n- Ensure missing facts are called out explicitly and no fabrication or inference of equipment/causes/dates/work occurred.\n- Confirm refusal of any mutation/closure/authorization requests.\nRespond by approving or rejecting. If rejecting, specify decision_status='rejected' in the tool UI notes; escalations may be required for missing evidence."
        },
        "outputs": [
          {
            "name": "approved",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "rejected",
            "schema": "boolean",
            "required": true
          },
          {
            "name": "decision_status",
            "schema": "string",
            "required": true
          }
        ]
