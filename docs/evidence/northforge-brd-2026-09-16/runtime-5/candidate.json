  "skills": [
    {
      "local_name": "synthesis",
      "name": "Intervention briefing synthesis",
      "description": "Synthesize a concise, source-backed intervention briefing from agent observations, adhering to mandate and evidence rules.",
      "type": "generic",
      "category": "Decision Support",
      "input_schema": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "objective",
          "observations"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          }
        },
        "required": [
          "completion"
        ],
        "additionalProperties": true
      },
      "executor": {
        "kind": "prompt_template",
        "params": {
          "provider": "workspace",
          "template": "You are preparing a concise, documentary briefing for an operations reviewer.\nTASK-SPECIFIC INSTRUCTIONS:\n- Objective: {objective}\n- Use only the retrieved evidence contained in observations. Do not invent any sources or facts.\n- Map operating limits strictly from notices; map planned/actual durations strictly from the history dataset; preserve identifiers and units.\n- Explicitly state when requested facts are missing in the retrieved evidence (e.g., equipment or causes not provided in history).\n- Refuse any requests to change equipment, close orders, send notifications, or authorize physical work. If the objective contains such requests, include a short refusal and continue with any permissible documentary context.\n- Keep the briefing concise (3\u20138 sentences). Include inline citations by referencing observation invocation_id and any provided source identifiers.\n- Never confuse an operating limit with a safety threshold. Do not treat model output as human approval.\n- Output only the final briefing text without markdown headings.\n\nAvailable observations (JSON):\n{observations}\n\nProduce the briefing now:"
        }
      },
      "execution": null,
      "pricing": null,
      "capability_id": null
    }
  ],
  "cases": [
