  "flow": {
    "test": "backend/app/tests/services/test_dataops_flow_eager.py::test_published_prepare_join_split_two_sql_workers",
    "modes": [
      "strict",
      "overlay"
    ],
    "route": "Published manual ingress -> prepare -> join(left edge/right pinned dataset) -> split(train/test) -> two SQL nodes -> sink",
    "execution": "Five real Skill invocations and RecipeExecution workers per mode, local ObjectStore, eager dispatch; no Skill, compiler, output or SQL worker stub.",
    "strict_inputs": "SQL nodes explicitly allow passthrough_inputs=[dataset_id]; the selected reference comes from the edge from_port merge, not a VariableRef bypassing the split.",
    "assertions": [
      "All five invocations and worker rows succeed",
      "Join/split input version IDs match the actual predecessors",
      "Each SQL dataset contains exactly its expected disjoint branch and doubled values",
      "SQL parent_ids select only the corresponding split version",
      "Real node_end checkpoints include per-port output versions/counts and join input versions/counts"
    ],
    "badge_unit": "Zero-row branches are preserved; graph-owned spoofed counts and storage/schema fields are excluded from the public badge."
  },
  "business_parity": [
    {
      "name": "prepare_history",
      "test": "backend/app/tests/services/test_dataops_business_parity.py::test_prepare_history_matches_existing_sql_with_timezone_aware_casts",
      "reference": "docs/demo-runs/showcase-ecommerce/fixtures/dataops/prepare_history.sql",
      "input_rows": 1236,
      "output_rows": 1200,
      "source": "Existing checked-in synthetic history CSV, imported as raw strings",
      "assertions": [
        "No-code casts include timestamp_tz",
        "Complete actual Arrow schema equals reference SQL schema",
        "Compiled schema including dtype/nullability equals reference schema",
        "SHA256 of canonical rows in explicit final sort order equals reference SQL output"
      ]
    },
    {
      "name": "Nawa A2",
      "test": "backend/app/tests/services/test_dataops_business_parity.py::test_nawa_a2_matches_existing_cleanup_sql_and_seeded_export",
      "reference": "backend/scripts/gen_nawa_telecom_data.py::clean_churn_sql",
      "seed": 20260825,
      "input_rows": 8412,
      "output_rows": 6903,
      "assertions": [
        "Deduplication precedes filtering, matching the historical business rule",
        "Complete actual Arrow schema equals reference SQL schema",
        "Compiled schema including dtype/nullability equals reference schema",
        "SHA256 of canonical rows in explicit final sort order equals reference SQL output"
      ]
    }
  ],
