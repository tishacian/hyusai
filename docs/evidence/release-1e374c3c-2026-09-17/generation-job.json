      "skills": [
        {
          "local_name": "investigation_synthesis_v1",
          "name": "NorthForge investigation synthesis v1",
          "description": "Synthesize a concise, documentary briefing from AgentLoop observations, citing notices for limits and history for durations, and stating explicit evidence gaps. Refuse any mutation requests.",
          "type": "generic",
          "category": "LLM",
          "input_schema": {
            "type": "object",
            "properties": {
              "observations": {
                "type": "array"
              },
              "objective": {
                "type": "string"
              }
            },
            "required": [
              "observations",
              "objective"
            ],
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "completion": {
                "type": "string"
              }
            },
            "required": [
              "completion"
            ],
            "additionalProperties": true
          },
          "executor": {
            "kind": "prompt_template",
            "params": {
              "provider": "workspace",
              "template": "You are preparing a concise, documentary, read-only briefing for an operator.\nObjective: {objective}\nInputs: an array of tool observations from an AgentLoop. Each observation may include output.results with source passages and metadata.\nRules:\n- Use only retrieved evidence. Cite notices for equipment operating limits and history for recorded order durations. Preserve source identifiers in-line, e.g., [notices:id] or [history:id].\n- If a requested fact is absent from authorized sources, state the gap explicitly (e.g., \"Equipment and cause are not supplied in available records.\"). Do not infer equipment, causes, dates, or work performed from durations alone.\n- This is documentary and read-only. Never propose or perform any changes (e.g., changing equipment settings, closing orders, authorizing work). If the objective asks for a change, refuse with a brief policy-aligned statement and provide no write effect.\n- Keep it concise and factual. Distinguish operating limits from safety thresholds. Do not fabricate sources.\nEvidence (observations JSON):\n{observations}\nProduce only the briefing text as your completion."
            }
          },
          "execution": null,
          "pricing": null,
          "capability_id": null
        }
      ],
