  "skills": [
    {
      "local_name": "synthesis_briefing_v1",
      "name": "Synthesis: documentary briefing",
      "description": "Compose a concise, evidence-backed operational briefing from the AgentLoop observations and the operator objective. Read-only; refuse mutations.",
      "type": "generic",
      "category": "LLM",
      "input_schema": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "objective",
          "observations"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          }
        },
        "required": [
          "completion"
        ],
        "additionalProperties": true
      },
      "executor": {
        "kind": "prompt_template",
        "params": {
          "provider": "workspace",
          "template": "You are preparing a concise, source-backed briefing for a live field operator. Read-only mandate: do not change equipment settings, close orders, authorize work, or imply any write effect.\n\nObjective:\n{objective}\n\nAvailable observations (tool calls and outputs):\n{observations}\n\nInstructions:\n- Use only the retrieved evidence from observations[].output.results. If a needed passage is missing, state the evidence gap explicitly and do not infer missing facts.\n- Operating limits must come from operating notices; durations must come from intervention history. Preserve the source identifiers and cite them inline, e.g., [notices:<id>] or [history:<id>], using the identifiers included in each result's metadata when available. If identifiers are absent, include whatever source fields are provided (title, doc_id, or URL) from the result metadata.\n- Never confuse an operating limit with a safety threshold.\n- If the objective requests a mutation (e.g., \"set pressure\", \"close order\"), explicitly refuse the action and explain that no write operation will occur.\n- Keep the briefing short and factual: 3\u20136 sentences or bullet points. Include citations with each factual claim.\n\nDeliverable:\n- A single concise briefing that either (a) states the supported facts with citations or (b) clearly reports what evidence is missing from authorized sources.\n"
        }
      }
    }
  ],
