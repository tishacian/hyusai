flowchart TB

    %% ════════════ 1. INGESTION ════════════
    subgraph INGEST ["📦 1 · INDEXATION — des données brutes au storage"]
        direction LR
        RAW["Données brutes<br/>ZIP SFTP · uploads PDF/Excel/HTML<br/><i>NU1569…/BBA120/Spare Parts List AKK200.pdf</i>"]
        PROMO["🔐 Secure Deposit<br/>promotion opérateur<br/>par vague"]
